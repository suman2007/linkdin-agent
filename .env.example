# Either key works; the model in config.yaml picks which one is used.
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: auto-login when the saved session expires. Leave BOTH blank to log in manually in the browser window.
# Keep these ONLY in .env (gitignored), never in config.yaml.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
